# =============================================================================
# 环境变量示例：复制为 .env 后填写实际取值
#   cp .env.example .env
#   编辑 .env 填入你的 API Key 等（.env 已在 .gitignore，不会提交）
# 安装 python-dotenv 后，generate_sft.py 会自动从项目根目录加载 .env
#   pip install python-dotenv
# =============================================================================

# -----------------------------------------------------------------------------
# SFT 数据生成 (data/scripts/generate_sft.py)
# -----------------------------------------------------------------------------
# API 提供商：openai 或 aliyun（阿里云 DashScope / Qwen）
# SFT_PROVIDER=openai

# --- OpenAI ---
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=                    # 可选，兼容接口的 base URL
# SFT_MODEL=gpt-4o                    # 教师模型（不填默认 gpt-4o）

# --- 阿里云 DashScope (Qwen 教师模型) ---
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DASHSCOPE_BASE_URL=                 # 可选，默认北京节点；美东: https://dashscope-us.aliyuncs.com/compatible-mode/v1
# SFT_MODEL=qwen-plus                 # 必须用 DashScope 的模型 ID，不能用 Hugging Face 名；可选: qwen-turbo | qwen-plus | qwen-max

# -----------------------------------------------------------------------------
# 评估 GPT-4 评判 (evaluation/gpt4_judge.py)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# 使用示例
# =============================================================================
# 仅用阿里云 Qwen 生成 SFT 数据：
#   SFT_PROVIDER=aliyun
#   DASHSCOPE_API_KEY=sk-你的密钥
#
# 仅用 OpenAI：
#   SFT_PROVIDER=openai
#   OPENAI_API_KEY=sk-你的密钥
# =============================================================================
